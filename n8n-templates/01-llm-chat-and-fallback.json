{
  "name": "TokenBuddy — OpenAI-Compatible LLM Chat with Structured Output",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "tokenbuddy-chat",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TOKENBUDDY_BASE_URL || 'https://tokenbuddy.site/v1' }}/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.TOKENBUDDY_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $json.body?.model || 'claude-sonnet-5-5', temperature: 0.2, messages: [{ role: 'system', content: 'You are a concise enterprise assistant. Reply in clean JSON with keys summary and action_items.' }, { role: 'user', content: $json.body?.prompt || 'Summarize Q3 AI gateway spend.' }] }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "tokenbuddy-chat-request",
      "name": "TokenBuddy Chat Completion",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { model: $json.model, content: $json.choices?.[0]?.message?.content, usage: $json.usage } }}",
        "options": {}
      },
      "id": "respond-webhook",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [760, 300]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "TokenBuddy Chat Completion",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "TokenBuddy Chat Completion": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": false
  }
}
